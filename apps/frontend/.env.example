# Firebase Web app config (PUBLIC — safe to ship to the browser).
# Copy this file to `.env` in this same folder, fill in the blanks, then restart the frontend.
#
# Where to find these values:
#   Firebase Console → your project (studybuddy-b11c6) → Project settings (gear icon)
#   → "Your apps" → Web app (</>) → "SDK setup and configuration" → Config.
# If no Web app exists yet, click "Add app" → Web (</>) to create one.
#
# These are prefilled from your project id. Only apiKey, messagingSenderId, and appId
# need to be copied from the console.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=studybuddy-b11c6.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=studybuddy-b11c6
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=studybuddy-b11c6.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
